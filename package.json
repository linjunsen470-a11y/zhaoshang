{
  "name": "zhaoshang-app",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.5.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --dir backend dev",
    "demo:connected": "pnpm --dir backend dev:connected",
    "mock:api": "node server.js",
    "mp:open": "node scripts/mp-open.mjs",
    "backend:dev": "pnpm --dir backend dev",
    "backend:build": "pnpm --dir backend build",
    "backend:start": "pnpm --dir backend start",
    "backend:lint": "pnpm --dir backend lint",
    "backend:seed": "pnpm --dir backend seed:demo",
    "backend:local": "pnpm backend:seed && pnpm backend:dev",
    "test:unit": "node --test --test-isolation=none tests/unit/*.test.mjs",
    "test:api": "pnpm --dir backend test:api && node --test --test-isolation=none tests/api/*.test.mjs",
    "test:api:integration": "node --test --test-isolation=none tests/api/*.test.mjs",
    "test:mp": "pnpm test:mp:smoke",
    "test:mp:smoke": "node --test --test-isolation=none tests/mp.test.mjs",
    "test:mp:smoke:junit": "node -e \"require('node:fs').mkdirSync('test-results/mp-e2e',{recursive:true})\" && node --test --test-isolation=none --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=test-results/mp-e2e/junit-smoke.xml tests/mp.test.mjs",
    "test:mp:full": "node --test --test-concurrency=1 --test-isolation=none tests/mp.test.mjs tests/mp-full.test.mjs",
    "test:mp:full:junit": "node -e \"require('node:fs').mkdirSync('test-results/mp-e2e',{recursive:true})\" && node --test --test-concurrency=1 --test-isolation=none --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=test-results/mp-e2e/junit-full.xml tests/mp.test.mjs tests/mp-full.test.mjs",
    "test:ci": "pnpm test:unit && pnpm test:api",
    "test:mp:commercial": "node --test --test-isolation=none tests/mp-commercial.test.mjs",
    "test:mp:local": "node --test --test-concurrency=1 --test-isolation=none tests/mp-local-scenes.test.mjs",
    "test:mp:interface": "node --test --test-force-exit --test-isolation=none tests/mp-interface.test.mjs",
    "launch:check": "node scripts/check-launch.mjs"
  },
  "devDependencies": {
    "miniprogram-automator": "^0.12.1"
  },
  "engines": {
    "node": ">=24"
  }
}
