# Payload
PAYLOAD_SECRET=your-very-strong-secret-change-me-in-production
MINIPROGRAM_TOKEN_SECRET=use-a-different-strong-random-value

# Database
# Local development PostgreSQL (cloud Compose has its own private db service):
DATABASE_URI=postgres://payload:change-this-postgres-password@your-postgres-host:5432/payload

# Local dev example:
# DATABASE_URI=postgres://payload:payload@localhost:5432/payload

# Public server URL for admin links and generated media URLs.
# Use 127.0.0.1 (not localhost) so WeChat DevTools matches mp/config.js API_URL.
PAYLOAD_PUBLIC_SERVER_URL=http://127.0.0.1:3000
# WeChat mini-program auth.
# Use dev for local debugging without a real AppSecret; use wechat in production.
WECHAT_AUTH_MODE=dev
WECHAT_AUTH_DEV_OPENID=dev-openid-local
WECHAT_APPID=wx98ad42097b40a52d
WECHAT_APP_SECRET=
# Use develop for local code testing; production uses release.
WECHAT_CODE_ENV_VERSION=develop

# Schema push: set true only when applying collection schema changes, then run:
#   pnpm --dir backend exec tsx scripts/push-schema.ts
# Leave false during normal dev to avoid slow/blocked first API requests.
PAYLOAD_DB_PUSH=false

# Optional unattended Tencent Docs MCP connection. Can also be saved by a local
# administrator at /admin/workspace/sync (stored in ignored .tencent-sync/).
# Never put these values in mini-program code or a public shared sheet.
TENCENT_DOCS_MCP_URL=https://docs.qq.com/openapi/mcp
TENCENT_DOCS_MCP_TOKEN=
