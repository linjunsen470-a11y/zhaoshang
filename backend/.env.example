# 本地 Next/Payload 开发配置；云端部署使用根目录 .env。
# UTF-8 编码；每项独占一行。密钥不要提交到 Git，也不要粘贴到聊天或日志。
# 修改本机此文件不会自动更新服务器配置或 GitHub Secrets。

# ── 独立本地开发数据库 ──
# 连接独立开发库，勿填云端业务库；密码特殊字符需 URL 编码。
DATABASE_URI=postgres://payload:change-this-postgres-password@your-postgres-host:5432/payload

# ── 应用密钥与访问地址 ──
# Payload 会话密钥，使用至少 32 字符的随机值。
PAYLOAD_SECRET=your-very-strong-secret-change-me-in-production
# 小程序令牌密钥，必须与 PAYLOAD_SECRET 不同。
MINIPROGRAM_TOKEN_SECRET=use-a-different-strong-random-value
# 后台与素材公开地址，云端必须使用真实 HTTPS 域名，不带 /admin 或 /api。
PAYLOAD_PUBLIC_SERVER_URL=http://127.0.0.1:3000
# 正常运行保持 false；云端 Compose 固定关闭，结构变更使用 schema:push。
PAYLOAD_DB_PUSH=false

# ── 微信小程序 ──
# 云端 Compose 固定为 wechat；dev 只用于本地模拟登录。
WECHAT_AUTH_MODE=dev
# 仅本地 dev 模式使用的测试身份。
WECHAT_AUTH_DEV_OPENID=dev-openid-local
# 须与 mp/project.config.json 的 AppID 一致。
WECHAT_APPID=wx98ad42097b40a52d
# 对应小程序的 AppSecret，仅保存在服务端。
WECHAT_APP_SECRET=
# 生成小程序码的目标版本：develop / trial / release。
WECHAT_CODE_ENV_VERSION=develop

# ── 腾讯文档连接 ──
# 可选：官方 MCP 地址；环境变量优先于 CMS 连接设置。
TENCENT_DOCS_MCP_URL=https://docs.qq.com/openapi/mcp
# 可选：环境变量优先于 CMS 保存的 Token；留空可使用后台连接设置。
TENCENT_DOCS_MCP_TOKEN=
