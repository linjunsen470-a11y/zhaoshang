<import src="../../templates/loading.wxml" />
<import src="../../templates/lead-form.wxml" />
<view class="container form-page e2e-renovation-form" data-test="renovation-form">
  <view class="form-header"><view class="form-title">{{isEditMode ? '修改装修需求' : '商铺装修咨询'}}</view><view class="form-desc">留下联系方式，顾问会与您沟通装修需求。</view></view>
  <view class="form-loading" wx:if="{{formLoading}}"><template is="loading-cards" data="{{kind: 'fields'}}" /></view>
  <view class="state-box" wx:elif="{{formLoadError}}"><text class="state-title">咨询信息加载失败</text><button class="btn btn-primary" bindtap="onRetryForm">重新加载</button></view>
  <block wx:else>
    <template is="lead-phone" data="{{phone, phoneAuthorizing, submitting, focusField, fieldErrors, maxPhoneLength}}" />
    <template is="lead-optional" data="{{showRegion: true, allowImages: false, attachments, uploadingImages, name, maxNameLength, regionPreference, maxRegionLength, remark, maxRemarkLength}}" />
    <view class="form-footer">
      <template is="lead-privacy" data="{{isEditMode, privacyAccepted, fieldErrors}}" />
      <view class="form-actions"><button class="btn btn-primary e2e-submit-lead" loading="{{submitting}}" disabled="{{submitting || uploadingImages || phoneAuthorizing}}" bindtap="onSubmitForm">{{submitting ? '正在提交…' : (isEditMode ? '保存修改' : '提交咨询')}}</button></view>
    </view>
  </block>
</view>
