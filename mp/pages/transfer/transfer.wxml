<import src="../../templates/loading.wxml" />
<import src="../../templates/lead-form.wxml" />
<view class="container form-page e2e-transfer-form" data-test="transfer-form">
  <view class="form-header"><view class="form-title">{{isEditMode ? '修改转让需求' : '委托店铺转让'}}</view><view class="form-desc">填写店铺大致区域和联系方式，顾问会与您沟通。</view></view>
  <view class="form-loading" wx:if="{{formLoading}}"><template is="loading-cards" data="{{kind: 'fields'}}" /></view>
  <view class="state-box" wx:elif="{{formLoadError}}"><text class="state-title">咨询信息加载失败</text><button class="btn btn-primary" bindtap="onRetryForm">重新加载</button></view>
  <block wx:else>
    <view class="form-section"><view class="form-card"><view id="field-locationText" class="form-item">
      <label for="input-locationText" class="item-label">店铺所在城市或区域 <text class="required-mark">*</text></label>
      <input id="input-locationText" aria-label="店铺所在城市或区域" class="item-input e2e-location-input" type="text" maxlength="{{maxRegionLength}}" placeholder="例如：广州天河" focus="{{focusField === 'locationText'}}" bindinput="onInputLocation" value="{{locationText}}" />
      <view class="field-error" wx:if="{{fieldErrors.locationText}}">{{fieldErrors.locationText}}</view>
    </view></view></view>
    <template is="lead-phone" data="{{phone, phoneAuthorizing, submitting, focusField, fieldErrors, maxPhoneLength}}" />
    <template is="lead-optional" data="{{showRegion: false, allowImages: true, attachments, uploadingImages, name, maxNameLength, remark, maxRemarkLength}}" />
    <view class="form-footer">
      <template is="lead-privacy" data="{{isEditMode, privacyAccepted, fieldErrors}}" />
      <view class="form-actions"><button class="btn btn-primary e2e-submit-lead" loading="{{submitting}}" disabled="{{submitting || uploadingImages || phoneAuthorizing}}" bindtap="onSubmitForm">{{submitting ? '正在提交…' : (isEditMode ? '保存修改' : '提交委托')}}</button></view>
    </view>
  </block>
</view>
