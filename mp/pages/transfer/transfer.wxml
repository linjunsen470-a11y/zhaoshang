<view class="container form-page e2e-transfer-form" data-test="transfer-form">
  <view class="form-header">
    <view class="form-title">{{isEditMode ? '修改转让需求' : '委托店铺转让'}}</view>
    <view class="form-desc">提交店铺位置、当前业态和转让预期，招商顾问会协助核验信息并联系意向方。</view>
  </view>
  <view class="form-loading" wx:if="{{formLoading || projectLoading}}">
    <view class="skeleton">
    </view>
    <view class="skeleton">
    </view>
  </view>
  <view class="state-box" wx:elif="{{formLoadError || projectLoadError}}">
    <text class="state-title">咨询信息加载失败</text>
    <text class="state-desc">请重新加载咨询信息后再填写。</text>
    <button class="btn btn-primary" bindtap="onRetryForm">重新加载</button>
  </view>
  <block wx:else>
    <view class="form-section">
      <view class="form-section-title">业务需求</view>
      <view class="form-card">
        <view id="field-locationText" class="form-item">
          <label for="input-locationText" class="item-label">
            店铺位置
            <text class="required-mark">*</text>
          </label>
          <input aria-label="店铺位置" id="input-locationText" focus="{{focusField === 'locationText'}}" class="item-input" type="text" maxlength="50" placeholder="例如：从化某高校商业街中段" bindinput="onInputLocation" value="{{locationText}}" />
          <view class="field-error" wx:if="{{fieldErrors.locationText}}">{{fieldErrors.locationText}}</view>
        </view>
        <view id="field-businessType" class="form-item">
          <label for="input-businessType" class="item-label">
            当前业态
            <text class="required-mark">*</text>
          </label>
          <input aria-label="当前业态" id="input-businessType" focus="{{focusField === 'businessType'}}" class="item-input" type="text" maxlength="100" placeholder="例如：轻食、奶茶、咖啡" bindinput="onInputBusiness" value="{{businessType}}" />
          <view class="field-error" wx:if="{{fieldErrors.businessType}}">{{fieldErrors.businessType}}</view>
        </view>
        <view class="form-item">
          <view class="item-label">面积与费用</view>
          <input aria-label="面积与费用" class="item-input" type="text" maxlength="100" placeholder="例如：30m²，月租 7800 元" bindinput="onInputFee" value="{{feeText}}" />
        </view>
        <view class="form-item">
          <view class="item-label">转让费预期</view>
          <input aria-label="转让费预期" class="item-input" type="text" maxlength="100" placeholder="例如：8 万元，可谈" bindinput="onInputTransferFee" value="{{transferFee}}" />
        </view>
        <view class="form-item">
          <view class="item-label">剩余合同期</view>
          <input aria-label="剩余合同期" class="item-input" type="text" maxlength="100" placeholder="例如：18 个月" bindinput="onInputTerm" value="{{remainingTerm}}" />
        </view>
        <radio-group class="form-item" bindchange="onEquipmentIncludedChange">
          <view class="item-label">是否包含设备</view>
          <label class="radio-line">
            <radio color="#204C3C" value="true" checked="{{includesEquipment}}" />
            含设备
          </label>
          <label class="radio-line">
            <radio color="#204C3C" value="false" checked="{{!includesEquipment}}" />
            不含/待定
          </label>
        </radio-group>
      </view>
    </view>
    <view class="form-section">
      <view class="form-section-title">联系方式</view>
      <view class="form-card">
        <view id="field-name" class="form-item">
          <label for="input-name" class="item-label">
            微信昵称
            <text class="required-mark">*</text>
          </label>
          <input aria-label="微信昵称" id="input-name" focus="{{focusField === 'name'}}" class="item-input" type="nickname" maxlength="20" placeholder="点此选择微信昵称" bindinput="onInputName" bindblur="onInputName" bindconfirm="onInputName" value="{{name}}" />
          <view class="field-error" wx:if="{{fieldErrors.name}}">{{fieldErrors.name}}</view>
        </view>
        <view id="field-phone" class="form-item">
          <label class="item-label">
            手机号
            <text class="required-mark">*</text>
          </label>
          <view class="phone-authorization">
            <text class="phone-value {{phone ? '' : 'phone-placeholder'}}">{{phone || '使用微信绑定的手机号'}}</text>
            <button class="phone-authorize-btn" open-type="getPhoneNumber" aria-label="授权获取微信手机号" bindgetphonenumber="onGetPhoneNumber" loading="{{phoneAuthorizing}}" disabled="{{phoneAuthorizing || submitting}}">{{phone ? '重新授权' : '微信授权获取'}}</button>
          </view>
          <view class="field-error" wx:if="{{fieldErrors.phone}}">{{fieldErrors.phone}}</view>
        </view>
      </view>
    </view>
    <view class="form-section">
      <view class="form-section-title">补充材料</view>
      <view class="form-card">
        <view class="form-item">
          <view class="item-label">补充说明</view>
          <textarea aria-label="补充说明" class="item-textarea" maxlength="500" placeholder="例如：可带店名、可协助交接、需保密沟通" bindinput="onInputRemark" value="{{remark}}" />
        </view>
        <view class="form-item border-none">
          <view class="item-label">
            店铺图片
            <text class="label-hint">最多 6 张</text>
          </view>
          <view class="attachment-grid">
            <view class="attachment-card" wx:for="{{attachments}}" wx:key="id">
              <view wx:if="{{item.imageError}}" class="attachment-img attachment-fallback">图片暂不可用</view>
              <image wx:else binderror="onAttachmentError" data-index="{{index}}" class="attachment-img" src="{{item.displayUrl}}" mode="aspectFill" bindtap="onPreviewAttachment" data-url="{{item.displayUrl}}" />
              <button aria-label="移除图片" class="attachment-remove" bindtap="onRemoveImage" data-index="{{index}}"><text class="ui-close" aria-hidden="true"></text></button>
            </view>
            <view role="button" aria-label="添加图片" class="upload-tile" bindtap="onChooseImages" wx:if="{{attachments.length < 6}}">
              <text class="upload-plus">+</text>
              <text class="upload-hint">{{uploadingImages ? '上传中' : '添加图片'}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
    <view id="field-privacy" class="privacy-consent" wx:if="{{!isEditMode}}" bindtap="onTogglePrivacy">
      <checkbox aria-label="已阅读并同意隐私政策" checked="{{privacyAccepted}}" color="#204C3C" />
      <text class="privacy-text">我已阅读并同意</text>
      <text class="privacy-link" catchtap="onGoPrivacy">《隐私政策》</text>
    </view>
    <view class="field-error privacy-error" wx:if="{{fieldErrors.privacy}}">{{fieldErrors.privacy}}</view>
    <view class="form-actions">
      <button class="btn btn-primary" loading="{{submitting}}" disabled="{{submitting || uploadingImages}}" bindtap="onSubmitForm">{{submitting ? '正在提交…' : (isEditMode ? '保存修改' : '提交委托')}}</button>
    </view>
  </block>
</view>
