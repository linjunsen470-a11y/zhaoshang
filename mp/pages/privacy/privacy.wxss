.privacy-page {
  padding: 32rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
}

.privacy-card {
  padding: 0;
  border: 0;
}

.privacy-title {
  font-size: 40rpx;
  font-weight: 600;
}

.privacy-meta {
  font-size: 24rpx;
  color: var(--muted);
  margin: 12rpx 0;
}

.privacy-meta + .privacy-section { margin-top: 40rpx; }

.privacy-section {
  margin-bottom: 32rpx;
}

.privacy-section .section-title {
  font-size: 30rpx;
  margin-bottom: 16rpx;
}

.section-text {
  font-size: 28rpx;
  line-height: 1.9;
  overflow-wrap: anywhere;
}

.privacy-back {
  margin-top: 40rpx;
  width: 100%;
}
