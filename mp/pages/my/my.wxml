<view class="container">
  <button class="profile" bindtap="onEditProfile" hover-class="entry-pressed" aria-label="编辑头像和联系方式">
    <view class="avatar-wrap">
      <image src="{{userInfo.avatar || '/images/icons/my.png'}}" class="{{userInfo.avatar ? 'profile-photo' : 'user-avatar'}}" mode="aspectFill" />
    </view>
    <view class="user-info flex-1">
      <view class="user-name">{{userInfo.nickname || '欢迎来到' + appName}}</view>
      <view class="user-phone">{{userInfo.phone || '点击设置头像和手机号'}}</view>
    </view>
    <text class="edit-btn">编辑</text>
  </button>
  <view class="section-caption">我的找铺</view>
  <view class="shortcut-grid">
    <navigator class="shortcut" url="/pages/leads/leads" hover-class="entry-pressed">
      <image class="line-icon" src="/images/icons/leads.png" />
      <view class="shortcut-title">咨询记录<text class="shortcut-count" wx:if="{{leadCount !== null}}">{{leadCount}}</text></view>
      <text class="shortcut-arrow"><text class="ui-chevron" aria-hidden="true"></text></text>
    </navigator>
    <view class="shortcut" aria-role="button" bindtap="onGoToFavorites" hover-class="entry-pressed">
      <image class="line-icon" src="/images/icons/star.png" />
      <view class="shortcut-title">收藏的空间<text class="shortcut-count">{{favoriteCount}}</text></view>
      <text wx:if="{{favoriteSyncStatus === 'error'}}" class="shortcut-desc">收藏同步失败</text>
      <text class="shortcut-arrow"><text class="ui-chevron" aria-hidden="true"></text></text>
    </view>
  </view>
  <view class="recent-entry" aria-role="button" bindtap="onGoToRecent" hover-class="entry-pressed"><text>最近浏览</text><text class="ui-chevron" aria-hidden="true"></text></view>
  <view class="section-caption">服务与帮助</view>
  <view class="menu-list">
    <view class="menu-item" aria-role="button" bindtap="onCallService" hover-class="entry-pressed">
      <image class="line-icon" src="/images/icons/phone.png" />
      <text class="menu-text">联系招商顾问</text>
      <text class="menu-arrow"><text class="ui-chevron" aria-hidden="true"></text></text>
    </view>
    <button class="menu-item" bindtap="onGoToPrivacy" hover-class="entry-pressed">
      <image class="line-icon" src="/images/icons/privacy.png" />
      <text class="menu-text">隐私政策</text>
      <text class="menu-arrow"><text class="ui-chevron" aria-hidden="true"></text></text>
    </button>
    <view class="menu-item" aria-role="button" bindtap="onShowAbout" hover-class="entry-pressed">
      <image class="line-icon" src="/images/icons/info.png" />
      <text class="menu-text">关于{{appName}}</text>
      <text class="menu-arrow"><text class="ui-chevron" aria-hidden="true"></text></text>
    </view>
  </view>
  <view class="operator-info">
    <view>运营主体：{{companyName}}</view>
    <view wx:if="{{miniProgramIcpNumber}}">{{miniProgramIcpNumber}}</view>
  </view>
  <view class="edit-modal-mask" wx:if="{{showEditModal}}" catchtouchmove="noop">
    <view class="edit-modal-box">
      <view class="modal-title">编辑个人资料</view>
      <view wx:if="{{profileStatus === 'loading'}}" class="modal-desc">正在读取账号资料…</view>
      <button wx:elif="{{profileStatus === 'error'}}" class="btn btn-secondary" bindtap="loadProfile">读取失败，点击重试</button>
      <block wx:else>
        <view class="modal-desc">保存后，可在其他手机用同一微信账号查看。</view>
        <view class="profile-avatar-row">
          <button class="avatar-picker" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" disabled="{{saving}}">
            <image src="{{editAvatar || '/images/icons/my.png'}}" mode="aspectFill" />选择头像
          </button>
          <button wx:if="{{editAvatar}}" class="text-link" bindtap="onRemoveAvatar" disabled="{{saving}}">移除头像</button>
        </view>
        <view class="modal-form-item">
          <label class="modal-label" for="profile-name">称呼（选填）</label>
          <input id="profile-name" type="text" class="modal-input" aria-label="称呼" maxlength="{{maxNameLength}}" placeholder="例如：陈先生" disabled="{{saving}}" bindinput="onNicknameInput" value="{{editNickname}}" />
        </view>
        <view class="modal-form-item">
          <label class="modal-label">手机号码</label>
          <view class="profile-phone-authorization">
            <input id="profile-phone" type="number" class="modal-input profile-phone-input" aria-label="手机号" maxlength="{{maxPhoneLength}}" placeholder="请输入手机号" bindinput="onProfilePhoneInput" value="{{editPhone}}" disabled="{{saving}}" />
            <button class="btn btn-secondary" open-type="getPhoneNumber" aria-label="授权获取微信手机号" bindgetphonenumber="onGetProfilePhone" disabled="{{saving}}">{{hasPhoneCode ? '重新授权' : '微信授权获取'}}</button>
          </view>
        </view>
        <text wx:if="{{hasPhoneCode}}">已授权，保存后绑定微信手机号</text>
      </block>
      <view class="modal-actions">
        <button class="btn btn-secondary" disabled="{{saving}}" bindtap="onCancelEdit">取消</button>
        <button class="btn btn-primary" bindtap="onSaveEdit" loading="{{saving}}" disabled="{{saving || profileStatus !== 'ready'}}">保存</button>
      </view>
    </view>
  </view>
</view>
