<view class="container">
  <view class="profile">
    <view class="avatar-wrap">
      <image src="/images/icons/my.png" class="user-avatar" />
    </view>
    <view class="user-info flex-1">
      <view class="user-name">{{userInfo.nickname || '欢迎来到' + appName}}</view>
      <view class="user-phone">{{userInfo.phone || '完善联系方式，咨询更省心'}}</view>
    </view>
    <button class="edit-btn" bindtap="onEditProfile">编辑</button>
  </view>
  <view class="section-caption">我的找铺</view>
  <view class="shortcut-grid">
    <button class="shortcut" bindtap="onGoToLeads">
      <image class="line-icon" src="/images/icons/leads.png" />
      <view class="shortcut-title">咨询记录<text class="shortcut-count" wx:if="{{leadCount !== null}}">{{leadCount}}</text></view>
      <view class="shortcut-desc">查看与管理已提交需求</view>
      <text class="shortcut-arrow"><text class="ui-chevron" aria-hidden="true"></text></text>
    </button>
    <button class="shortcut" bindtap="onGoToFavorites">
      <image class="line-icon" src="/images/icons/star.png" />
      <view class="shortcut-title">收藏的空间<text class="shortcut-count">{{favoriteCount}}</text></view>
      <view class="shortcut-desc">收藏仅保存在本机</view>
      <text class="shortcut-arrow"><text class="ui-chevron" aria-hidden="true"></text></text>
    </button>
  </view>
  <button class="recent-entry" bindtap="onGoToRecent"><view><view>最近浏览</view><view class="shortcut-desc">{{recentCount}} 处房源，接着比较心仪空间</view></view><text class="ui-chevron" aria-hidden="true"></text></button>
  <view class="section-caption">服务与帮助</view>
  <view class="menu-list">
    <button class="menu-item" bindtap="onCallService">
      <image class="line-icon" src="/images/icons/phone.png" />
      <text class="menu-text">联系招商顾问</text>
      <text class="menu-arrow"><text class="ui-chevron" aria-hidden="true"></text></text>
    </button>
    <button class="menu-item" bindtap="onGoToPrivacy">
      <image class="line-icon" src="/images/icons/privacy.png" />
      <text class="menu-text">隐私政策</text>
      <text class="menu-arrow"><text class="ui-chevron" aria-hidden="true"></text></text>
    </button>
    <button class="menu-item" bindtap="onShowAbout">
      <image class="line-icon" src="/images/icons/info.png" />
      <text class="menu-text">关于{{appName}}</text>
      <text class="menu-arrow"><text class="ui-chevron" aria-hidden="true"></text></text>
    </button>
  </view>
  <view class="operator-info">
    <view>运营主体：{{companyName}}</view>
    <view wx:if="{{miniProgramIcpNumber}}">{{miniProgramIcpNumber}}</view>
  </view>
  <view class="edit-modal-mask" wx:if="{{showEditModal}}" catchtouchmove="noop">
    <view class="edit-modal-box">
      <view class="modal-title">编辑联系信息</view>
      <view class="modal-desc">填写或授权手机号，之后咨询时自动带入。称呼可不填。</view>
      <view class="modal-form-item">
        <label class="modal-label" for="profile-name">称呼（选填）</label>
        <input id="profile-name" type="text" class="modal-input" aria-label="称呼" maxlength="{{maxNameLength}}" placeholder="例如：陈先生" bindinput="onNicknameInput" value="{{editNickname}}" />
      </view>
      <view class="modal-form-item">
        <label class="modal-label">手机号码</label>
        <view class="profile-phone-authorization">
          <input id="profile-phone" type="number" class="modal-input profile-phone-input" aria-label="手机号" maxlength="{{maxPhoneLength}}" placeholder="请输入手机号" bindinput="onProfilePhoneInput" value="{{editPhone}}" disabled="{{phoneAuthorizing}}" />
          <button class="btn btn-secondary" open-type="getPhoneNumber" aria-label="授权获取微信手机号" bindgetphonenumber="onGetProfilePhone" loading="{{phoneAuthorizing}}" disabled="{{phoneAuthorizing}}">微信授权获取</button>
        </view>
      </view>
      <view class="modal-actions">
        <button class="btn btn-secondary" bindtap="onCancelEdit">取消</button>
        <button class="btn btn-primary" bindtap="onSaveEdit" disabled="{{phoneAuthorizing}}">保存</button>
      </view>
    </view>
  </view>
</view>
