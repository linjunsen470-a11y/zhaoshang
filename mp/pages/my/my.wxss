.container {
  padding: 40rpx 32rpx 64rpx;
}

.profile {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding-bottom: 40rpx;
  border-bottom: 1rpx solid var(--line);
}

.avatar-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 104rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: var(--pine-soft);
}

.user-avatar {
  width: 52rpx;
  height: 52rpx;
}

.user-name {
  font-size: 32rpx;
  font-weight: 600;
  overflow-wrap: anywhere;
}

.user-phone {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--muted);
}

.edit-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 44px;
  min-height: 44px;
  padding: 8rpx 0 8rpx 16rpx;
  font-size: 24rpx;
  background: transparent;
  color: var(--pine);
}

.section-caption {
  margin: 40rpx 0 24rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.shortcut-grid {
  display: flex;
  gap: 16rpx;
}

.shortcut {
  position: relative;
  flex: 1;
  min-width: 0;
  padding: 24rpx;
  background: var(--wash);
  border-radius: 16rpx;
  line-height: 1.5;
  text-align: left;
}

.shortcut-title {
  margin-top: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}

.shortcut-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--muted);
}

.shortcut-arrow {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  color: var(--muted);
}

.menu-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  width: 100%;
  min-height: 112rpx;
  padding: 24rpx 0;
  background: transparent;
  border-radius: 0;
  border-bottom: 1rpx solid var(--line);
  text-align: left;
  line-height: 1.6;
}

.menu-text {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: var(--ink);
}

.menu-arrow {
  color: var(--muted);
}

.edit-modal-mask {
  position: fixed;
  inset: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(24,35,31,.4);
  z-index: 1000;
}

.edit-modal-box {
  width: 100%;
  max-height: 90vh;
  overflow-y: auto;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
}

.modal-desc {
  margin: 16rpx 0 32rpx;
  color: var(--muted);
  font-size: 26rpx;
  line-height: 1.7;
}

.modal-form-item {
  margin: 24rpx 0;
}

.modal-label {
  display: block;
  margin-bottom: 16rpx;
  font-size: 26rpx;
}

.modal-input {
  width: 100%;
  min-height: 44px;
  height: 88rpx;
  padding: 16rpx;
  font-size: 28rpx;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
}

.modal-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
}

.modal-actions .btn {
  flex: 1;
}

.shortcut-count { margin-left: 12rpx; font-size: 24rpx; color: var(--pine); }
.recent-entry { margin-top: 16rpx; padding: 24rpx; width: 100%; display: flex; align-items: center; justify-content: space-between; background: var(--wash); border-radius: 16rpx; font-size: 28rpx; text-align: left; color: var(--ink); line-height: 1.5; }
.edit-modal-box { animation: sheet-in 200ms ease-out; }

.profile-phone-authorization { display: flex; align-items: center; gap: 16rpx; }
.profile-phone-value { flex: 1; min-width: 0; font-size: 26rpx; overflow-wrap: anywhere; }
.profile-phone-authorization .btn { flex-shrink: 0; font-size: 24rpx; padding: 16rpx; }
