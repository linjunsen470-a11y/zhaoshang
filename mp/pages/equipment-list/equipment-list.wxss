.container {
  min-height: 100vh;
  background: var(--wash);
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.tabs-bar {
  position: sticky;
  top: 0;
  display: flex;
  padding: 8rpx 16rpx;
  background: #fff;
  border-bottom: 1rpx solid var(--line);
  z-index: 10;
}

.tab-item {
  flex: 1;
  min-width: 0;
  min-height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 4rpx;
  font-size: 24rpx;
  color: var(--muted);
  border-bottom: 4rpx solid transparent;
}

.tab-item.active {
  color: var(--pine);
  border-color: var(--pine);
  font-weight: 600;
}

.list-body {
  padding: 24rpx 32rpx;
}

.equipment-card {
  padding: 24rpx;
  border: 0;
}

.card-header {
  gap: 16rpx;
  align-items: flex-start;
}

.title-block {
  flex: 1;
  min-width: 0;
  align-items: flex-start;
  gap: 12rpx;
}

.title {
  font-size: 30rpx;
  font-weight: 600;
  white-space: normal;
  overflow-wrap: anywhere;
  line-height: 1.5;
}

.tag {
  flex-shrink: 0;
  padding: 4rpx 10rpx;
  font-size: 22rpx;
  background: var(--pine-soft);
  color: var(--pine);
  border-radius: 6rpx;
}

.tag-buy {
  background: var(--sand);
  color: var(--sand-ink);
}

.tag-recycle {
  background: var(--wash);
  color: var(--muted);
}

.date-lbl {
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--muted);
}

.card-details {
  margin-top: 24rpx;
}

.detail-row {
  font-size: 26rpx;
}

.detail-label {
  width: 120rpx;
}

.highlight-price {
  color: var(--pine);
  font-weight: 600;
  font-size: 28rpx;
}

.card-remark {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--muted);
  line-height: 1.7;
  overflow-wrap: anywhere;
}

.images-scroll {
  width: 100%;
  margin-top: 24rpx;
  white-space: nowrap;
}

.images-track {
  display: inline-flex;
  gap: 16rpx;
}

.image-item {
  display: block;
  flex-shrink: 0;
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  background: var(--wash);
}

.image-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--muted);
  font-size: 24rpx;
}

.card-actions {
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--line);
}

.privacy-tip {
  font-size: 22rpx;
  color: var(--muted);
  flex: 1;
  min-width: 180rpx;
}

.btn-action {
  font-size: 26rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 80rpx 8rpx;
  text-align: center;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
}

.empty-desc {
  color: var(--muted);
  font-size: 26rpx;
  line-height: 1.8;
}

.reset-btn {
  margin-top: 16rpx;
}

.publish-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--line);
  background: #fff;
  z-index: 20;
}

.publish-bar .btn {
  width: 100%;
}

.equipment-copy {
  min-height: 44px;
  padding: 16rpx 0;
  text-align: left;
  color: var(--pine);
  background: transparent;
  font-size: 24rpx;
}
