.form-page {
  padding: 24rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  background: var(--wash);
  min-height: 100vh;
}

.form-header {
  padding: 8rpx 0 32rpx;
}
.scene-hint { margin-top: 12rpx; color: var(--muted); font-size: 24rpx; line-height: 1.6; }

.form-title {
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.5;
}

.form-desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--muted);
  line-height: 1.7;
}

.form-section {
  margin-bottom: 32rpx;
}

.form-section-title {
  font-size: 28rpx;
  font-weight: 600;
  margin: 0 0 16rpx 4rpx;
}

.form-card {
  padding: 8rpx 24rpx;
  border-radius: 16rpx;
  background: #fff;
}

.form-item {
  display: flex;
  flex-direction: column;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.form-item:last-child, .border-none {
  border-bottom: 0;
}

.item-label {
  display: block;
  font-size: 26rpx;
  color: var(--ink);
  margin-bottom: 16rpx;
}

.label-hint {
  margin-left: 12rpx;
  font-size: 24rpx;
  color: var(--muted);
}

.item-input, .picker-value, .picker-inner {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 44px;
  height: 88rpx;
  padding: 16rpx;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  font-size: 28rpx;
  color: var(--ink);
  background: #fff;
  line-height: 1.5;
}

.picker-value::after, .picker-inner::after {
  content: '';
  width: 12rpx;
  height: 12rpx;
  border-right: 2rpx solid currentColor;
  border-bottom: 2rpx solid currentColor;
  transform: rotate(45deg);
  margin-right: 6rpx;
  margin-left: auto;
  color: var(--muted);
  flex-shrink: 0;
}

.picker-inner.placeholder {
  color: var(--muted);
}

.item-textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 16rpx;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  font-size: 28rpx;
  color: var(--ink);
  line-height: 1.7;
}

.radio-line {
  display: flex;
  align-items: center;
  min-height: 44px;
  font-size: 28rpx;
}

.field-error {
  margin-top: 12rpx;
  color: var(--danger);
  font-size: 24rpx;
  line-height: 1.6;
}

.attachment-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.attachment-card, .upload-tile {
  position: relative;
  width: calc((100% - 32rpx) / 3);
  height: 176rpx;
  border-radius: 12rpx;
  background: var(--wash);
}

.attachment-img {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.attachment-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: var(--muted);
}

.attachment-remove {
  position: absolute;
  right: -8rpx;
  top: -8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 44px;
  min-height: 44px;
  padding: 0;
  border-radius: 12rpx;
  background: rgba(24,35,31,.75);
  color: #fff;
  font-size: 32rpx;
}

.upload-tile {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 1rpx dashed #b9c7be;
}

.upload-plus {
  font-size: 40rpx;
  color: var(--pine);
  line-height: 1;
}

.upload-hint {
  margin-top: 12rpx;
  color: var(--muted);
  font-size: 22rpx;
}

.project-context {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx;
  margin: 0 0 32rpx;
  border: 0;
}

.project-context-cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: var(--wash);
}

.project-context-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--muted);
  font-size: 22rpx;
}

.project-context-info {
  min-width: 0;
  flex: 1;
}

.project-context-label {
  font-size: 24rpx;
  color: var(--muted);
}

.project-context-title {
  font-size: 28rpx;
  font-weight: 600;
  overflow-wrap: anywhere;
}

.project-context-fee {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--pine);
}

.privacy-consent {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  min-height: 44px;
  font-size: 24rpx;
  color: var(--muted);
}

.privacy-consent checkbox {
  flex-shrink: 0;
}

.privacy-link {
  display: inline-flex;
  align-items: center;
  min-height: 44px;
  color: var(--pine);
}

.privacy-error {
  margin: 0 0 16rpx;
}

.form-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.form-actions .btn {
  flex: 1;
}

.clear-form {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 44px;
  margin-top: 16rpx;
  padding: 8rpx;
  background: transparent;
  color: var(--muted);
  font-size: 24rpx;
}


.phone-authorization { display: flex; align-items: center; gap: 16rpx; min-height: 88rpx; }
.phone-value { flex: 1; min-width: 0; font-size: 28rpx; overflow-wrap: anywhere; }
.phone-placeholder { color: var(--muted); font-size: 24rpx; }
.phone-authorize-btn { display: flex; align-items: center; justify-content: center; flex-shrink: 0; min-height: 44px; padding: 16rpx 20rpx; background: var(--pine-soft); color: var(--pine); border-radius: 12rpx; font-size: 24rpx; line-height: 1.5; }

.character-count { margin-top: 8rpx; text-align: right; color: var(--muted); font-size: 22rpx; font-variant-numeric: tabular-nums; }
.region-shortcut { display: inline-flex; align-items: center; gap: 12rpx; min-height: 44px; margin-top: 8rpx; padding: 8rpx 16rpx; border-radius: 8rpx; background: var(--pine-soft); color: var(--pine); font-size: 24rpx; }
