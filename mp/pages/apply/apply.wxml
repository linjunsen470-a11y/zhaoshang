<import src="../../templates/loading.wxml" />
<import src="../../templates/lead-form.wxml" />
<view class="container form-page">
  <view class="form-header">
    <view class="form-title">{{isEditMode ? '修改咨询信息' : (projectTitle ? '咨询该项目或铺位' : '提交找铺需求')}}</view>
    <view class="form-desc" wx:if="{{!projectTitle}}">留下联系方式，顾问会协助您找铺。</view>
  </view>
  <view class="form-loading" wx:if="{{formLoading || projectLoading}}"><template is="loading-cards" data="{{kind: 'fields'}}" /></view>
  <view class="state-box" wx:elif="{{formLoadError || projectLoadError}}">
    <text class="state-title">咨询信息加载失败</text><text class="state-desc">请重新加载咨询信息后再填写。</text>
    <button class="btn btn-primary" bindtap="onRetryForm">重新加载</button>
  </view>
  <block wx:else>
    <view class="project-context card" wx:if="{{projectTitle}}">
      <image class="project-context-cover" src="{{projectCover}}" mode="aspectFill" wx:if="{{projectCover && !projectCoverError}}" binderror="onProjectCoverError" />
      <view wx:else class="project-context-cover project-context-fallback">暂无图片</view>
      <view class="project-context-info"><view class="project-context-label">{{isEditMode ? '原咨询对象' : '正在咨询'}}</view><view class="project-context-title">{{projectTitle}}</view><view class="project-context-fee" wx:if="{{projectFeeText}}">{{projectFeeText}}</view></view>
    </view>
    <template is="lead-phone" data="{{phone, phoneAuthorizing, submitting, focusField, fieldErrors, maxPhoneLength}}" />
    <template is="lead-optional" data="{{showRegion: !projectId, allowImages: false, attachments, uploadingImages, name, maxNameLength, regionPreference, maxRegionLength, remark, maxRemarkLength}}" />
    <view class="form-footer">
      <template is="lead-privacy" data="{{isEditMode, privacyAccepted, fieldErrors}}" />
      <view class="form-actions"><button class="btn btn-primary e2e-submit-lead" data-test="submit-lead" loading="{{submitting}}" disabled="{{submitting || uploadingImages || phoneAuthorizing}}" bindtap="onSubmitForm">{{submitting ? '正在提交…' : (isEditMode ? '保存修改' : '提交咨询')}}</button></view>
    </view>
  </block>
</view>
