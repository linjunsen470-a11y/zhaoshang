.container {
  padding: 24rpx 32rpx 48rpx;
  min-height: 100vh;
  background: var(--wash);
}

.leads-header {
  padding: 8rpx 0 24rpx;
}

.phone-tip {
  color: var(--muted);
  font-size: 24rpx;
}

.phone-number {
  color: var(--ink);
}

.top-notice-bar {
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
  background: var(--pine-soft);
  color: var(--pine);
  font-size: 24rpx;
  line-height: 1.7;
  border-radius: 12rpx;
}

.lead-card {
  padding: 24rpx;
  border: 0;
}

.lead-card-header {
  gap: 16rpx;
}

.lead-project-title {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.link-text {
  color: var(--pine);
}

.status-tag {
  flex-shrink: 0;
  margin-top: 4rpx;
}

.lead-specs {
  padding: 24rpx 0;
}

.spec-grid {
  gap: 12rpx;
}

.spec-cell {
  width: 100%;
  font-size: 26rpx;
}

.spec-lbl {
  color: var(--muted);
}

.spec-val {
  color: var(--ink);
}

.spec-desc-row {
  margin-top: 20rpx;
  font-size: 26rpx;
  line-height: 1.7;
  overflow-wrap: anywhere;
}

.detail-line {
  margin-top: 8rpx;
}

.spec-val-desc {
  white-space: pre-wrap;
}

.lead-attachments {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 24rpx;
}

.lead-attachment-img {
  width: calc((100% - 24rpx) / 3);
  height: 160rpx;
  border-radius: 12rpx;
  background: var(--wash);
}

.attachment-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--muted);
  font-size: 22rpx;
}

.lead-time-footer {
  flex-wrap: wrap;
  gap: 8rpx 24rpx;
  border-top: 1rpx solid var(--line);
  padding-top: 16rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.lead-actions {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 16rpx;
}

.lead-edit {
  flex: 1;
  font-size: 26rpx;
}

.lead-delete {
  min-height: 44px;
  padding: 12rpx 16rpx;
  font-size: 24rpx;
  background: transparent;
  color: var(--danger);
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 96rpx 16rpx;
  text-align: center;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
}

.empty-desc {
  color: var(--muted);
  font-size: 26rpx;
}

.empty-icon {
  color: var(--pine);
  font-size: 40rpx;
}

.reset-btn {
  margin-top: 16rpx;
}

.loading-state .skeleton {
  height: 320rpx;
  background: #fff;
  margin-bottom: 24rpx;
}
