.container {
  padding: 24rpx 32rpx 48rpx;
  min-height: 100vh;
  background: var(--wash);
}

.leads-header {
  padding: 8rpx 0 24rpx;
}

.phone-tip {
  color: var(--muted);
  font-size: 24rpx;
}

.phone-number {
  color: var(--ink);
}

.top-notice-bar {
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
  background: var(--pine-soft);
  color: var(--pine);
  font-size: 24rpx;
  line-height: 1.7;
  border-radius: 12rpx;
}

.lead-card {
  padding: 24rpx;
  border: 0;
}

.lead-card-header {
  gap: 16rpx;
}

.lead-project-title {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.link-text {
  color: var(--pine);
}

.status-tag {
  flex-shrink: 0;
  margin-top: 4rpx;
}

.lead-specs {
  padding: 24rpx 0;
}

.spec-grid {
  gap: 12rpx;
  padding: 20rpx;
  background: var(--wash);
  border-radius: 12rpx;
}

.spec-cell {
  width: calc((100% - 12rpx) / 2);
  min-width: 0;
  display: flex;
  flex-direction: column;
  overflow-wrap: anywhere;
  font-size: 26rpx;
}

.spec-lbl {
  color: var(--muted);
}

.spec-val {
  color: var(--ink);
}

.spec-desc-row {
  margin-top: 20rpx;
  font-size: 26rpx;
  line-height: 1.7;
  overflow-wrap: anywhere;
}

.detail-line {
  margin-top: 8rpx;
}

.spec-val-desc {
  white-space: pre-wrap;
}

.lead-attachments {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 24rpx;
}

.lead-attachment-img {
  width: calc((100% - 24rpx) / 3);
  height: 160rpx;
  border-radius: 12rpx;
  background: var(--wash);
}

.attachment-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--muted);
  font-size: 22rpx;
}

.lead-time-footer {
  flex-wrap: wrap;
  gap: 8rpx 24rpx;
  border-top: 1rpx solid var(--line);
  padding-top: 16rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.lead-actions {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 16rpx;
}

.lead-edit {
  flex: 1;
  font-size: 26rpx;
}

.lead-delete {
  min-height: 44px;
  padding: 12rpx 16rpx;
  font-size: 24rpx;
  background: transparent;
  color: var(--danger);
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 96rpx 16rpx;
  text-align: center;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
}

.empty-desc {
  color: var(--muted);
  font-size: 26rpx;
}

.empty-icon {
  color: var(--pine);
  font-size: 40rpx;
}

.reset-btn {
  margin-top: 16rpx;
}


.lead-progress { display: flex; gap: 12rpx; margin-top: 28rpx; }
.progress-step { flex: 1; font-size: 22rpx; color: var(--muted); }
.progress-line { height: 6rpx; background: var(--line); border-radius: 8rpx; margin-bottom: 10rpx; }
.reached { color: var(--pine); }
.reached .progress-line { background: var(--pine); }
.lead-summary { margin-top: 24rpx; color: var(--ink); font-size: 26rpx; }
.lead-summary-time { margin-top: 8rpx; color: var(--muted); font-size: 22rpx; }
.expand-details { width: 100%; min-height: 44px; margin-top: 12rpx; padding: 12rpx 0; display: flex; align-items: center; justify-content: space-between; background: transparent; color: var(--pine); font-size: 24rpx; }
.chevron-up { transform: rotate(-45deg); }
.empty-illustration { display: flex; align-items: center; justify-content: center; width: 144rpx; height: 144rpx; border-radius: 48rpx; background: var(--pine-soft); margin-bottom: 16rpx; }
.empty-illustration .line-icon { width: 64rpx; height: 64rpx; }
