<import src="../../templates/loading.wxml" />
<view class="container">
  <view class="leads-header" wx:if="{{phone}}">
    <view class="phone-tip">
      <text class="phone-label">你的联系电话：</text>
      <text class="phone-number">{{phone}}</text>
    </view>
  </view>
  <view class="top-notice-bar" wx:if="{{phone && leadsList.length > 0}}">后续沟通以微信或电话为准，请保持联系方式畅通。</view>
  <view class="leads-body">
    <view class="loading-state" wx:if="{{loading}}">
      <template is="loading-cards" data="{{kind: 'fields'}}" />
    </view>
    <view class="state-box" wx:elif="{{loadError}}">
      <text class="state-title">咨询记录加载失败</text>
      <text class="state-desc">请检查网络连接后重新加载。</text>
      <button class="btn btn-primary" bindtap="onRetryLoad">重新加载</button>
    </view>
    <block wx:else>
      <view class="leads-list" wx:if="{{leadsList.length > 0}}">
        <view class="lead-card card e2e-lead-card" data-test="lead-card" wx:for="{{leadsList}}" wx:for-index="leadIndex" wx:key="id">
          <view class="lead-card-header flex justify-between align-start">
            <view class="lead-project-title ellipsis-2 e2e-lead-title {{item.projectId ? 'link-text' : ''}}" data-test="lead-title" bindtap="onGoToProject" data-id="{{item.projectId}}">{{item.projectTitle ? item.projectTitle : '自主提交需求'}}</view>

          </view>
          <view class="lead-progress" aria-label="当前进度：{{item.statusInfo.name}}"><view class="progress-step reached"><view class="progress-line"></view><text>已提交</text></view><view class="progress-step {{item.statusInfo.step >= 2 ? 'reached' : ''}}"><view class="progress-line"></view><text>已联系</text></view><view class="progress-step {{item.statusInfo.step >= 3 ? 'reached' : ''}}"><view class="progress-line"></view><text>已结束</text></view></view>
          <view class="lead-summary">{{item.leadTypeLabel}}<text wx:if="{{item.businessType}}"> · {{item.businessType}}</text></view>
          <view class="lead-summary-time">{{item.formattedTime}}</view>
          <button class="expand-details" bindtap="onToggleDetails" data-id="{{item.id}}" aria-expanded="{{item.expanded}}">{{item.expanded ? '收起详情' : '展开详情'}}<text class="ui-chevron {{item.expanded ? 'chevron-up' : 'ui-chevron-down'}}" aria-hidden="true"></text></button>
          <view class="lead-specs" wx:if="{{item.expanded}}">
            <view class="spec-grid flex flex-wrap">
              <view class="spec-cell">
                <text class="spec-lbl">需求类型：</text>
                <text class="spec-val">{{item.leadTypeLabel}}</text>
              </view>
              <view class="spec-cell" wx:if="{{item.businessType}}">
                <text class="spec-lbl">品类/设备：</text>
                <text class="spec-val">{{item.businessType}}</text>
              </view>
              <view class="spec-cell" wx:if="{{item.budgetRange}}">
                <text class="spec-lbl">预算/价格：</text>
                <text class="spec-val">{{item.budgetRange}}</text>
              </view>
              <view class="spec-cell" wx:if="{{item.regionPreference}}">
                <text class="spec-lbl">区域：</text>
                <text class="spec-val">{{item.regionPreference}}</text>
              </view>
              <view class="spec-cell" wx:if="{{item.leadType === 'leasing' && item.businessScene === 'campus'}}">
                <text class="spec-lbl">校园经营经验：</text>
                <text class="spec-val">{{item.hasCampusExperience ? '有校园经验' : '暂无校园经验'}}</text>
              </view>
            </view>
            <view class="spec-desc-row" wx:if="{{item.transferDetails}}">
              <view class="detail-line" wx:if="{{item.transferDetails.locationText}}">店铺位置：{{item.transferDetails.locationText}}</view>
              <view class="detail-line" wx:if="{{item.transferDetails.feeText}}">面积费用：{{item.transferDetails.feeText}}</view>
              <view class="detail-line" wx:if="{{item.transferDetails.transferFee}}">转让费：{{item.transferDetails.transferFee}}</view>
              <view class="detail-line" wx:if="{{item.transferDetails.remainingTerm}}">剩余合同：{{item.transferDetails.remainingTerm}}</view>
              <view class="detail-line">包含设备：{{item.transferDetails.includesEquipment ? '是' : '否/待定'}}</view>
            </view>
            <view class="spec-desc-row" wx:if="{{item.equipmentDetails}}">
              <view class="detail-line" wx:if="{{item.equipmentDetails.equipmentName}}">设备名称：{{item.equipmentDetails.equipmentName}}</view>
              <view class="detail-line" wx:if="{{item.equipmentDetails.specText}}">数量规格：{{item.equipmentDetails.specText}}</view>
              <view class="detail-line" wx:if="{{item.equipmentDetails.equipmentCondition}}">设备状态：{{item.equipmentDetails.equipmentCondition}}</view>
              <view class="detail-line" wx:if="{{item.equipmentDetails.expectedPrice}}">期望价格：{{item.equipmentDetails.expectedPrice}}</view>
            </view>
            <view class="spec-desc-row" wx:if="{{item.remark}}">
              <text class="spec-lbl">留言备注：</text>
              <text class="spec-val-desc e2e-lead-remark" data-test="lead-remark">{{item.remark}}</text>
            </view>
            <view class="lead-attachments" wx:if="{{item.attachments && item.attachments.length}}">
              <block wx:for="{{item.attachments}}" wx:for-item="img" wx:for-index="imageIndex" wx:key="id">
                <view wx:if="{{img.imageError}}" class="lead-attachment-img attachment-fallback">图片暂不可用</view>
                <image wx:else class="lead-attachment-img" src="{{img.displayUrl}}" mode="aspectFill" lazy-load binderror="onAttachmentError" data-lead-index="{{leadIndex}}" data-image-index="{{imageIndex}}" bindtap="onPreviewAttachment" data-lead-id="{{item.id}}" data-url="{{img.displayUrl}}" />
              </block>
            </view>
          </view>
          <view class="lead-time-footer flex justify-between align-center" wx:if="{{item.expanded}}">
            <text class="lead-id-lbl">咨询编号：{{item.displayId || item.id}}</text>
            <text class="lead-time-lbl">提交于：{{item.formattedTime}}</text>
          </view>
          <view class="lead-actions" wx:if="{{item.expanded}}">
            <button class="btn btn-secondary lead-edit e2e-edit-lead" data-test="edit-lead" bindtap="onEditLead" data-id="{{item.id}}" data-type="{{item.leadType}}">编辑需求</button>
            <button class="lead-delete e2e-delete-lead" data-test="delete-lead" bindtap="onDeleteLead" data-id="{{item.id}}">删除</button>
          </view>
        </view>
      </view>
      <view class="empty-state" wx:else>
        <view class="empty-illustration"><image class="line-icon" src="/images/icons/leads.png" /></view>
        <text class="empty-title">暂无咨询记录</text>
        <text class="empty-desc">当前登录身份下还没有提交记录。</text>
        <navigator url="/pages/list/list" open-type="switchTab" class="btn btn-primary reset-btn">查看项目与铺位</navigator>
      </view>
    </block>
  </view>
</view>
