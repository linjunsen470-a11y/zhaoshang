.success-container {
  padding: 80rpx 32rpx 64rpx;
}

.success-card {
  border: 0;
  padding: 48rpx 24rpx;
  text-align: center;
}

.success-icon {
  margin-bottom: 32rpx;
}

.success-title {
  font-size: 40rpx;
  font-weight: 600;
}

.success-desc {
  max-width: 560rpx;
  margin-top: 24rpx;
  color: var(--muted);
  font-size: 28rpx;
  line-height: 1.8;
}

.btn-group {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 40rpx;
}

.action-btn {
  width: 100%;
}

.btn-group .btn-outline {
  border: 0;
  color: var(--pine);
}

.next-steps { padding: 28rpx; background: var(--wash); border-radius: 16rpx; color: var(--muted); font-size: 25rpx; }
.next-title { color: var(--ink); font-size: 28rpx; font-weight: 600; margin-bottom: 20rpx; }
.next-steps > view + view { display: flex; align-items: flex-start; gap: 16rpx; margin-top: 16rpx; }
.step-num { flex-shrink: 0; display: inline-flex; justify-content: center; align-items: center; width: 36rpx; height: 36rpx; border-radius: 50%; color: var(--pine); background: #e1ece5; font-size: 22rpx; }
