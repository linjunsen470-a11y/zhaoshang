.success-container {
  padding: 80rpx 32rpx 64rpx;
}

.success-card {
  border: 0;
  padding: 48rpx 24rpx;
  text-align: center;
}

.success-icon {
  margin-bottom: 32rpx;
}

.success-title {
  font-size: 40rpx;
  font-weight: 600;
}

.success-desc {
  max-width: 560rpx;
  margin-top: 24rpx;
  color: var(--muted);
  font-size: 28rpx;
  line-height: 1.8;
}

.btn-group {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 40rpx;
}

.action-btn {
  width: 100%;
}

.btn-group .btn-outline {
  border: 0;
  color: var(--pine);
}
