.success-container {
  padding: 64rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
}

.success-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 32rpx 32rpx;
  border-radius: 20rpx;
  background: var(--wash);
  text-align: center;
}

.success-title {
  margin-top: 24rpx;
  font-size: 40rpx;
  font-weight: 600;
}

.success-desc {
  max-width: 520rpx;
  margin: 16rpx auto 40rpx;
  color: var(--muted);
  font-size: 28rpx;
  line-height: 1.7;
}

.action-btn {
  width: 100%;
}

.receipt-links {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 24rpx;
  margin-top: 16rpx;
}

.receipt-links button {
  min-height: 44px;
  padding: 12rpx 24rpx;
  background: transparent;
  color: var(--pine);
  font-size: 26rpx;
}
