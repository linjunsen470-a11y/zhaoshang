<view class="container success-container">
  <view class="success-card">
    <icon type="success" size="48" color="#204C3C" aria-hidden="true" />
    <view class="success-title">{{title}}</view>
    <view class="success-desc">{{nextStep}}</view>
    <button class="btn btn-primary action-btn e2e-view-leads" data-test="view-created-lead" hover-class="btn-primary-active" bindtap="onViewLeads">{{leadId ? '查看本次咨询' : '查看咨询记录'}}</button>
  </view>
  <view class="receipt-links">
    <button hover-class="tap-active" bindtap="onGoHome">返回首页</button>
    <button hover-class="tap-active" bindtap="onCallAdvisor">联系顾问</button>
  </view>
</view>
