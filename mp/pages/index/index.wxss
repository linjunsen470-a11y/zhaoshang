@import "../../styles/project-card.wxss";
.container {
  padding-bottom: 48rpx;
}

.masthead {
  padding: 24rpx 32rpx 0;
}

.brand-line {
  color: var(--muted);
  font-size: 24rpx;
}

.home-title {
  margin-top: 8rpx;
  font-size: 36rpx;
  line-height: 1.4;
  font-weight: 600;
  letter-spacing: -1rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 8rpx 8rpx 8rpx 24rpx;
  margin-top: 24rpx;
  border: 1rpx solid var(--line);
  background: var(--wash);
  border-radius: 12rpx;
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.search-bar input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  font-size: 26rpx;
}

.search-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 44px;
  padding: 0 24rpx;
  color: #fff;
  background: var(--pine);
  border-radius: 8rpx;
  font-size: 26rpx;
  line-height: 1.5;
}

.scene-row {
  display: flex;
  padding: 24rpx 24rpx 16rpx;
}

.scene-item {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  background: transparent;
  padding: 8rpx 0;
  font-size: 24rpx;
  line-height: 1.4;
  color: var(--ink);
  border-radius: 12rpx;
}

.scene-icon {
  width: 48rpx;
  height: 48rpx;
}

.service-row {
  display: flex;
  margin: 0 32rpx;
  padding: 4rpx 0;
  background: var(--wash);
  border-radius: 12rpx;
}

.service-item {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  flex: 1;
  min-width: 0;
  min-height: 44px;
  padding: 0;
  background: transparent;
  color: var(--muted);
  font-size: 24rpx;
  line-height: 1.5;
}

.service-arrow {
  color: #8a9990;
}

.section-container {
  padding: 32rpx 32rpx 0;
}

.section-header .section-more {
  background: transparent;
  padding: 0;
  font-weight: 400;
}

.recommended-scroll {
  width: calc(100% + 32rpx);
  white-space: nowrap;
}

.recommended-track {
  display: inline-flex;
  padding-right: 32rpx;
  gap: 24rpx;
}

.recommended-item {
  width: 560rpx;
  flex: 0 0 560rpx;
  overflow: hidden;
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  background: #fff;
  white-space: normal;
}

.rec-media, .rec-cover {
  position: relative;
  display: block;
  width: 560rpx;
  height: 420rpx;
  background: var(--wash);
}

.rec-cover.property-fallback {
  display: flex;
}

.rec-copy {
  position: relative;
  padding: 24rpx;
  padding-right: 80rpx;
}

.rec-kicker {
  font-size: 22rpx;
  color: var(--pine);
}

.rec-title {
  margin-top: 8rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.rec-place {
  margin-top: 8rpx;
  color: var(--muted);
  font-size: 24rpx;
}

.rec-price {
  margin-top: 16rpx;
  color: var(--pine);
  font-size: 28rpx;
  font-weight: 600;
  overflow-wrap: anywhere;
}

.rec-favorite {
  position: absolute;
  right: 8rpx;
  top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  min-width: 44px;
  min-height: 44px;
  background: transparent;
}

.rec-favorite image {
  width: 36rpx;
  height: 36rpx;
}

.latest-section {
  margin-top: 8rpx;
}

.advisor-link {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  width: 100%;
  margin-top: 32rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: var(--pine-soft);
  color: var(--pine);
  line-height: 1.5;
  text-align: left;
}

.advisor-title {
  font-size: 28rpx;
  font-weight: 600;
}

.advisor-desc {
  margin-top: 4rpx;
  color: var(--muted);
  font-size: 24rpx;
}

.skeleton-title {
  width: 200rpx;
  height: 36rpx;
  margin-bottom: 24rpx;
}

.skeleton-cover {
  width: 560rpx;
  max-width: 100%;
  height: 420rpx;
}

.skeleton-line {
  width: 60%;
  height: 32rpx;
  margin-top: 24rpx;
}

.skeleton-row {
  height: 200rpx;
  margin-top: 40rpx;
}
