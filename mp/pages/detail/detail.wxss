.container {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.swiper-wrap, .detail-swiper, .swiper-image, .gallery-skeleton {
  width: 100%;
  height: 562.5rpx;
  background: var(--wash);
}

.swiper-wrap {
  position: relative;
}

.gallery-frame {
  position: relative;
}

.gallery-share {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  min-width: 44px;
  min-height: 44px;
  padding: 0;
  background: transparent;
  border: 0;
}

.share-icon {
  display: block;
  width: 48rpx;
  height: 48rpx;
}

.image-fallback {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  color: var(--muted);
  font-size: 26rpx;
}

.swiper-count {
  position: absolute;
  bottom: 24rpx;
  padding: 6rpx 16rpx;
  background: rgba(24,35,31,.7);
  color: #fff;
  font-size: 22rpx;
  border-radius: 8rpx;
}

.swiper-count {
  right: 24rpx;
}


.detail-body {
  padding: 32rpx;
}

.title-tools {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.kicker {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
  font-size: 24rpx;
  color: var(--muted);
}

.project-title-large {
  margin-top: 8rpx;
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.4;
  overflow-wrap: anywhere;
}

.key-figures {
  display: flex;
  gap: 24rpx;
  margin-top: 32rpx;
  padding: 24rpx;
  background: var(--wash);
  border-radius: 16rpx;
}

.fee-figure {
  flex: 1.4;
  min-width: 0;
}

.area-figure {
  flex: 1;
  min-width: 0;
  padding-left: 24rpx;
  border-left: 1rpx solid var(--line);
}

.figure-label, .param-label, .minor-label {
  font-size: 24rpx;
  color: var(--muted);
}

.rent-value {
  margin-top: 8rpx;
  font-size: 36rpx;
  font-weight: 600;
  color: var(--pine);
  line-height: 1.4;
  overflow-wrap: anywhere;
}

.area-value {
  margin-top: 8rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.fee-note {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.7;
}

.rent-note, .update-lbl, .unit-meta {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--muted);
  line-height: 1.6;
}

.detail-section {
  margin-top: 40rpx;
  padding-top: 32rpx;
  border-top: 1rpx solid var(--line);
}

.section-label {
  margin-bottom: 24rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.spec-grid {
  display: flex;
  flex-wrap: wrap;
  column-gap: 24rpx;
  row-gap: 24rpx;
}

.spec-cell {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  width: calc((100% - 24rpx) / 2);
  min-width: 0;
}

.param-val {
  font-size: 28rpx;
  overflow-wrap: anywhere;
}

.related-project, .address-row, .unit-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  width: 100%;
  min-height: 44px;
  padding: 24rpx 0;
  color: var(--ink);
  background: transparent;
  border-radius: 0;
  font-size: 28rpx;
  line-height: 1.7;
  text-align: left;
}

.related-project {
  padding: 24rpx;
  margin-top: 24rpx;
  border-radius: 12rpx;
  background: var(--pine-soft);
  color: var(--pine);
}

.address-row {
  margin-top: 16rpx;
  border-top: 1rpx solid var(--line);
}

.address-row > view, .related-project > view, .unit-copy {
  flex: 1;
  min-width: 0;
  overflow-wrap: anywhere;
}

.copy-hint {
  font-size: 24rpx;
  color: var(--pine);
  flex-shrink: 0;
}

.prose-block + .prose-block {
  margin-top: 24rpx;
}

.prose-block {
  margin-top: 24rpx;
}

.minor-label {
  margin-bottom: 12rpx;
}

.desc-text, .highlight-item {
  font-size: 28rpx;
  line-height: 1.85;
  overflow-wrap: anywhere;
  white-space: pre-wrap;
}

.highlight-item {
  position: relative;
  padding-left: 24rpx;
}

.highlight-item::before {
  content: '';
  position: absolute;
  top: 22rpx;
  left: 0;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--pine);
}

.biz-tag-container {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.biz-tag {
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.tag-fit {
  background: var(--pine-soft);
  color: var(--pine);
}

.tag-unfit {
  background: var(--wash);
  color: var(--muted);
}

.unit-row {
  border-bottom: 1rpx solid var(--line);
}

.unit-title {
  font-size: 28rpx;
}

.unit-meta {
  margin-top: 8rpx;
}

.bottom-action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
  z-index: 100;
  background: #fff;
  border-top: 1rpx solid var(--line);
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
}

.icon-action {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  min-width: 44px;
  min-height: 44px;
  padding: 0;
  background: transparent;
  font-size: 22rpx;
  color: var(--muted);
  line-height: 1.5;
}

.action-glyph {
  width: 36rpx;
  height: 36rpx;
  margin-bottom: 4rpx;
}

.action-btn {
  flex: 1;
  min-width: 0;
  min-height: 88rpx;
  padding: 16rpx;
}

.gallery-skeleton {
  border-radius: 0;
}

.text-skeleton {
  margin: 32rpx;
  height: 40rpx;
}

.text-skeleton.short {
  width: 48%;
}

.detail-anchors { position: sticky; top: 0; z-index: 90; display: flex; padding: 8rpx 16rpx; background: #fff; border-bottom: 1rpx solid var(--line); }
.detail-anchors button { flex: 1; min-height: 44px; display: flex; justify-content: center; align-items: center; background: transparent; color: var(--muted); font-size: 25rpx; padding: 8rpx; }
.fee-grid { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 16rpx; }
.fee-cell { flex: 1; min-width: 160rpx; display: flex; flex-direction: column; gap: 8rpx; padding: 20rpx; border: 1rpx solid var(--line); border-radius: 12rpx; font-size: 26rpx; }
.advisor-card { display: flex; align-items: center; gap: 20rpx; padding: 24rpx; margin-top: 40rpx; background: var(--pine-soft); border-radius: 16rpx; }
.advisor-copy { flex: 1; min-width: 0; }
.advisor-title { font-weight: 600; font-size: 28rpx; }
.advisor-desc { margin-top: 6rpx; color: var(--muted); font-size: 22rpx; }
.advisor-card button { min-height: 44px; padding: 12rpx; display: flex; align-items: center; color: var(--pine); background: #fff; font-size: 24rpx; border-radius: 12rpx; }
