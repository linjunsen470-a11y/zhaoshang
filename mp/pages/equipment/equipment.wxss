@import "../apply/apply.wxss";
.type-tabs {
  display: flex;
  gap: 4rpx;
  padding: 4rpx;
  border: 0;
  background: #e5ece7;
  margin: 0 0 32rpx;
  border-radius: 12rpx;
}

.type-tab {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 44px;
  padding: 12rpx 4rpx;
  color: var(--muted);
  font-size: 24rpx;
  line-height: 1.5;
  border-radius: 8rpx;
}

.type-tab.active {
  background: #fff;
  color: var(--pine);
  font-weight: 600;
}
