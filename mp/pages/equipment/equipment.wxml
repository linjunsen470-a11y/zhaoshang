<import src="../../templates/loading.wxml" />
<view class="container form-page e2e-equipment-form" data-test="equipment-form">
  <view class="form-header">
    <view class="form-title">{{isEditMode ? '修改供需信息' : '设备供需登记'}}</view>
    <view class="form-desc">提交餐饮设备出售、求购或回收需求；资料审核通过后可公开展示，并由运营人员协助沟通。</view>
  </view>
  <view class="form-loading" wx:if="{{formLoading || projectLoading}}">
    <template is="loading-cards" data="{{kind: 'fields'}}" />
  </view>
  <view class="state-box" wx:elif="{{formLoadError || projectLoadError}}">
    <text class="state-title">咨询信息加载失败</text>
    <text class="state-desc">请重新加载咨询信息后再填写。</text>
    <button class="btn btn-primary" bindtap="onRetryForm">重新加载</button>
  </view>
  <block wx:else>
    <view class="type-tabs card">
      <view class="type-tab {{leadType === 'equipment_sell' ? 'active' : ''}}" bindtap="onTypeTap" data-type="equipment_sell">出售设备</view>
      <view class="type-tab {{leadType === 'equipment_buy' ? 'active' : ''}}" bindtap="onTypeTap" data-type="equipment_buy">求购设备</view>
      <view class="type-tab {{leadType === 'equipment_recycle' ? 'active' : ''}}" bindtap="onTypeTap" data-type="equipment_recycle">回收咨询</view>
    </view>
    <view class="form-section">
      <view class="form-section-title">业务需求</view>
      <view class="form-card">
        <view id="field-equipmentName" class="form-item">
          <label for="input-equipmentName" class="item-label">
            设备名称
            <text class="required-mark">*</text>
          </label>
          <input aria-label="设备名称" id="input-equipmentName" focus="{{focusField === 'equipmentName'}}" class="item-input" type="text" maxlength="100" placeholder="例如：冷藏柜、制冰机、炒炉、操作台" bindinput="onInputEquipmentName" value="{{equipmentName}}" />
          <view class="field-error" wx:if="{{fieldErrors.equipmentName}}">{{fieldErrors.equipmentName}}</view>
        </view>
        <view class="form-item">
          <view class="item-label">数量/规格</view>
          <input aria-label="数量和规格" class="item-input" type="text" maxlength="100" placeholder="例如：双门、八成新、220V" bindinput="onInputSpec" value="{{specText}}" />
        </view>
        <view class="form-item">
          <view class="item-label">设备状态</view>
          <input aria-label="设备状态" class="item-input" type="text" maxlength="100" placeholder="例如：正常使用、轻微划痕、需自提" bindinput="onInputCondition" value="{{equipmentCondition}}" />
        </view>
        <view class="form-item">
          <view class="item-label">{{leadType === 'equipment_buy' ? '采购预算' : '期望价格'}}</view>
          <input aria-label="预算或期望价格" class="item-input" type="text" maxlength="100" placeholder="例如：3000 元以内，可议" bindinput="onInputBudget" value="{{budgetRange}}" />
        </view>
        <view id="field-regionPreference" class="form-item">
          <label for="input-regionPreference" class="item-label">所在区域</label>
          <input aria-label="意向区域" id="input-regionPreference" focus="{{focusField === 'regionPreference'}}" class="item-input" type="text" maxlength="50" placeholder="例如：广州大学城、天河" bindinput="onInputRegion" value="{{regionPreference}}" />
          <picker mode="selector" range="{{regionOptions}}" bindchange="onChooseRegion" aria-label="快捷选择区域">
            <view class="region-shortcut">快捷选择区域<text class="ui-chevron ui-chevron-down" aria-hidden="true"></text></view>
          </picker>
          <view class="field-error" wx:if="{{fieldErrors.regionPreference}}">{{fieldErrors.regionPreference}}</view>
        </view>
      </view>
    </view>
    <view class="form-section">
      <view class="form-section-title">联系方式</view>
      <view class="form-card">
        <view id="field-name" class="form-item">
          <label for="input-name" class="item-label">
            微信昵称
            <text class="required-mark">*</text>
          </label>
          <input aria-label="微信昵称" id="input-name" focus="{{focusField === 'name'}}" class="item-input" type="nickname" maxlength="20" placeholder="点此选择微信昵称" bindinput="onInputName" bindblur="onInputName" bindconfirm="onInputName" value="{{name}}" />
          <view class="field-error" wx:if="{{fieldErrors.name}}">{{fieldErrors.name}}</view>
        </view>
        <view id="field-phone" class="form-item">
          <label class="item-label">
            手机号
            <text class="required-mark">*</text>
          </label>
          <view class="phone-authorization">
            <text class="phone-value {{phone ? '' : 'phone-placeholder'}}">{{phone || '使用微信绑定的手机号'}}</text>
            <button class="phone-authorize-btn" open-type="getPhoneNumber" aria-label="授权获取微信手机号" bindgetphonenumber="onGetPhoneNumber" loading="{{phoneAuthorizing}}" disabled="{{phoneAuthorizing || submitting}}">{{phone ? '重新授权' : '微信授权获取'}}</button>
          </view>
          <view class="field-error" wx:if="{{fieldErrors.phone}}">{{fieldErrors.phone}}</view>
        </view>
      </view>
    </view>
    <view class="form-section">
      <view class="form-section-title">补充材料</view>
      <view class="form-card">
        <view class="form-item">
          <view class="item-label">补充说明</view>
          <textarea aria-label="补充说明" class="item-textarea" maxlength="{{maxRemarkLength}}" placeholder="例如：可自提、需发票、希望本周成交" bindinput="onInputRemark" value="{{remark}}" />
          <view class="character-count">{{remark.length}} / {{maxRemarkLength}}</view>
        </view>
        <view class="form-item border-none">
          <view class="item-label">
            设备图片
            <text class="label-hint">最多 6 张</text>
          </view>
          <view class="attachment-grid">
            <view class="attachment-card" wx:for="{{attachments}}" wx:key="id">
              <view wx:if="{{item.imageError}}" class="attachment-img attachment-fallback">图片暂不可用</view>
              <image wx:else binderror="onAttachmentError" data-index="{{index}}" class="attachment-img" src="{{item.displayUrl}}" mode="aspectFill" bindtap="onPreviewAttachment" data-url="{{item.displayUrl}}" />
              <button aria-label="移除图片" class="attachment-remove" bindtap="onRemoveImage" data-index="{{index}}"><text class="ui-close" aria-hidden="true"></text></button>
            </view>
            <view role="button" aria-label="添加图片" class="upload-tile" bindtap="onChooseImages" wx:if="{{attachments.length < 6}}">
              <text class="upload-plus">+</text>
              <text class="upload-hint">{{uploadingImages ? '上传中' : '添加图片'}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
    <view id="field-privacy" class="privacy-consent" wx:if="{{!isEditMode}}" bindtap="onTogglePrivacy">
      <checkbox aria-label="已阅读并同意隐私政策" checked="{{privacyAccepted}}" color="#204C3C" />
      <text class="privacy-text">我已阅读并同意</text>
      <text class="privacy-link" catchtap="onGoPrivacy">《隐私政策》</text>
    </view>
    <view class="field-error privacy-error" wx:if="{{fieldErrors.privacy}}">{{fieldErrors.privacy}}</view>
    <view class="form-actions">
      <button class="btn btn-primary" loading="{{submitting}}" disabled="{{submitting || uploadingImages}}" bindtap="onSubmitForm">{{submitting ? '正在提交…' : (isEditMode ? '保存修改' : '提交审核')}}</button>
    </view>
  </block>
</view>
