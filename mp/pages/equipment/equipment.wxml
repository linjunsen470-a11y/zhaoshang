<import src="../../templates/loading.wxml" />
<import src="../../templates/lead-form.wxml" />
<view class="container form-page e2e-equipment-form" data-test="equipment-form">
  <view class="form-header"><view class="form-title">{{isEditMode ? '修改供需信息' : '设备供需登记'}}</view><view class="form-desc">提交设备需求，工作人员审核后再决定是否公开。</view></view>
  <view class="form-loading" wx:if="{{formLoading}}"><template is="loading-cards" data="{{kind: 'fields'}}" /></view>
  <view class="state-box" wx:elif="{{formLoadError}}"><text class="state-title">咨询信息加载失败</text><button class="btn btn-primary" bindtap="onRetryForm">重新加载</button></view>
  <block wx:else>
    <view id="field-leadType" class="form-section">
      <view class="form-section-title">需求类型 <text class="required-mark">*</text></view>
      <view class="type-tabs card">
        <button class="type-tab {{leadType === 'equipment_sell' ? 'active' : ''}}" bindtap="onTypeTap" data-type="equipment_sell" disabled="{{isEditMode}}">出售设备</button>
        <button class="type-tab {{leadType === 'equipment_buy' ? 'active' : ''}}" bindtap="onTypeTap" data-type="equipment_buy" disabled="{{isEditMode}}">求购设备</button>
        <button class="type-tab {{leadType === 'equipment_recycle' ? 'active' : ''}}" bindtap="onTypeTap" data-type="equipment_recycle" disabled="{{isEditMode}}">回收咨询</button>
      </view>
      <view class="field-error" wx:if="{{fieldErrors.leadType}}">{{fieldErrors.leadType}}</view>
    </view>
    <view class="form-section"><view class="form-card"><view id="field-equipmentName" class="form-item">
      <label for="input-equipmentName" class="item-label">设备名称 <text class="required-mark">*</text></label>
      <input id="input-equipmentName" aria-label="设备名称" class="item-input e2e-equipment-name" type="text" maxlength="{{maxTextLength}}" placeholder="例如：冷藏柜、制冰机" focus="{{focusField === 'equipmentName'}}" bindinput="onInputEquipmentName" value="{{equipmentName}}" />
      <view class="field-error" wx:if="{{fieldErrors.equipmentName}}">{{fieldErrors.equipmentName}}</view>
    </view></view></view>
    <template is="lead-phone" data="{{phone, phoneAuthorizing, submitting, focusField, fieldErrors, maxPhoneLength}}" />
    <template is="lead-optional" data="{{showRegion: false, allowImages: true, attachments, uploadingImages, name, maxNameLength, remark, maxRemarkLength}}" />
    <view class="form-footer">
      <template is="lead-privacy" data="{{isEditMode, privacyAccepted, fieldErrors}}" />
      <view class="form-actions"><button class="btn btn-primary e2e-submit-lead" loading="{{submitting}}" disabled="{{submitting || uploadingImages || phoneAuthorizing}}" bindtap="onSubmitForm">{{submitting ? '正在提交…' : (isEditMode ? '保存修改' : '提交审核')}}</button></view>
    </view>
  </block>
</view>
