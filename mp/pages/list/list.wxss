@import "../../styles/project-card.wxss";
.container {
  min-height: 100vh;
}

.sticky-header {
  position: sticky;
  top: 0;
  z-index: 100;
  padding-top: 16rpx;
  background: #fff;
  border-bottom: 1rpx solid var(--line);
}

.search-box {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 88rpx;
  margin: 0 32rpx;
  padding: 8rpx 16rpx 8rpx 24rpx;
  border-radius: 12rpx;
  background: var(--wash);
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.search-box input {
  flex: 1;
  min-width: 0;
  height: 64rpx;
  font-size: 26rpx;
}

.clear-btn, .sheet-close {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  min-width: 44px;
  min-height: 44px;
  background: transparent;
  color: var(--muted);
  font-size: 36rpx;
}

.scene-scroll {
  width: 100%;
  white-space: nowrap;
}

.scene-tabs {
  display: inline-flex;
  gap: 8rpx;
  padding: 16rpx 24rpx 8rpx;
}

.scene-tab {
  flex: none;
  min-height: 44px;
  display: flex;
  align-items: center;
  padding: 0 16rpx;
  color: var(--muted);
  background: transparent;
  font-size: 26rpx;
  border-bottom: 4rpx solid transparent;
}

.scene-active {
  color: var(--pine);
  font-weight: 600;
  border-color: var(--pine);
}

.kind-tabs {
  display: flex;
  margin: 8rpx 32rpx;
  padding: 4rpx;
  border-radius: 12rpx;
  background: var(--wash);
}

.kind-tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 44px;
  padding: 0 8rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--muted);
  background: transparent;
  border-radius: 8rpx;
}

.kind-active {
  color: var(--pine);
  background: #fff;
  font-weight: 600;
}

.filter-tabs {
  display: flex;
  padding: 0 16rpx;
}

.filter-tab-item {
  flex: 1;
  min-width: 0;
  min-height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 8rpx;
  font-size: 24rpx;
  background: transparent;
  color: var(--muted);
}

.active-filter {
  color: var(--pine);
  font-weight: 600;
}

.filter-chevron {
  flex-shrink: 0;
  font-size: 24rpx;
}

.list-body {
  padding: 16rpx 32rpx 48rpx;
}

.selected-filters {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin: 8rpx 0;
}

.filter-chip {
  display: flex;
  gap: 16rpx;
  align-items: center;
  min-height: 44px;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  background: var(--pine-soft);
  color: var(--pine);
}

.results-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 44px;
  font-size: 24rpx;
  color: var(--muted);
}

.reset-btn-link {
  min-height: 44px;
  padding: 8rpx 0 8rpx 24rpx;
  background: transparent;
  color: var(--pine);
  font-size: 24rpx;
}

.fav-local-tip, .empty-tip {
  font-size: 24rpx;
  color: var(--muted);
  padding: 16rpx 0;
}

.empty-tip {
  text-align: center;
  padding: 32rpx 0;
}

.skeleton-card {
  height: 232rpx;
  margin: 24rpx 0;
}

.filter-drawer-container {
  position: fixed;
  inset: 0;
  z-index: 200;
}

.drawer-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(24,35,31,.4);
}

.filter-sheet {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  flex-direction: column;
  max-height: 84vh;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding-bottom: env(safe-area-inset-bottom);
}

.sheet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx 16rpx 32rpx;
  flex-shrink: 0;
}

.sheet-scroll {
  min-height: 0;
  height: 56vh;
}

.filter-group, .single-options {
  padding: 0 32rpx 32rpx;
}

.group-label {
  margin: 16rpx 0;
  font-size: 28rpx;
  font-weight: 600;
}

.option-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.option-item {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 44px;
  min-width: calc((100% - 24rpx) / 3);
  padding: 16rpx;
  font-size: 24rpx;
  color: var(--muted);
  background: var(--wash);
  border-radius: 12rpx;
  line-height: 1.5;
}

.selected-option {
  background: var(--pine-soft);
  color: var(--pine);
  box-shadow: inset 0 0 0 1rpx var(--pine);
}

.sheet-actions {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 32rpx;
  border-top: 1rpx solid var(--line);
  flex-shrink: 0;
}

.sheet-actions .btn:first-child {
  flex: 1;
}

.sheet-actions .btn:last-child {
  flex: 2;
}
