page {
  --ink: #18231f;
  --paper: #ffffff;
  --card: #ffffff;
  --wash: #f3f6f4;
  --muted: #67746d;
  --line: #e5ebe7;
  --pine: #204c3c;
  --pine-soft: #eaf2ed;
  --bronze: #204c3c;
  --sand: #f6f0e5;
  --sand-ink: #80643d;
  --danger: #a33434;
  background: var(--paper);
  color: var(--ink);
  font: 28rpx/1.6 -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
}

view, scroll-view, text, button, input, textarea, form, navigator, image {
  box-sizing: border-box;
}

button {
  margin: 0;
}

button::after {
  border: 0;
}

.color-primary, .color-success {
  color: var(--pine);
}

.color-warning {
  color: var(--sand-ink);
}

.color-danger {
  color: var(--danger);
}

.color-secondary {
  color: var(--muted);
}

.bg-white, .bg-slate {
  background: var(--paper);
}

.p-20 {
  padding: 20rpx;
}

.p-30 {
  padding: 32rpx;
}

.m-b-20 {
  margin-bottom: 24rpx;
}

.m-b-30 {
  margin-bottom: 32rpx;
}

.flex {
  display: flex;
}

.flex-col {
  flex-direction: column;
}

.flex-row {
  flex-direction: row;
}

.align-center {
  align-items: center;
}

.align-start {
  align-items: flex-start;
}

.justify-between {
  justify-content: space-between;
}

.justify-center {
  justify-content: center;
}

.flex-1 {
  flex: 1;
  min-width: 0;
}

.flex-wrap {
  flex-wrap: wrap;
}

.card {
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-height: 44px;
  padding: 20rpx 32rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.5;
}

.btn-primary {
  background: var(--pine);
  color: #fff;
}

.btn-secondary {
  background: var(--pine-soft);
  color: var(--pine);
}

.btn-outline {
  background: #fff;
  border: 1rpx solid var(--line);
  color: var(--ink);
}

.btn[disabled], .is-disabled {
  background: var(--wash);
  color: var(--muted);
}

.btn-primary-active, .btn-secondary-active, .btn-outline-active, .tap-active {
  opacity: .7;
}

.badge {
  display: inline-block;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-weight: 400;
  white-space: nowrap;
}

.badge-online {
  color: var(--pine);
  background: var(--pine-soft);
}

.badge-coming {
  color: var(--sand-ink);
  background: var(--sand);
}

.badge-draft, .badge-full, .badge-offline {
  color: var(--muted);
  background: var(--wash);
}

.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ellipsis-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.detail-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
  font-size: 26rpx;
}

.detail-label {
  width: 140rpx;
  flex-shrink: 0;
  color: var(--muted);
}

.detail-value {
  flex: 1;
  min-width: 0;
  overflow-wrap: anywhere;
}

.required-mark {
  color: var(--pine);
}

.line-icon {
  display: block;
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
}

.section-more {
  display: flex;
  align-items: center;
  min-height: 44px;
  font-size: 24rpx;
  color: var(--muted);
}

.skeleton {
  background: var(--wash);
  border-radius: 12rpx;
}

.state-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 64rpx 24rpx;
  text-align: center;
}

.state-title {
  font-size: 32rpx;
  font-weight: 600;
}

.state-desc {
  font-size: 26rpx;
  color: var(--muted);
  line-height: 1.7;
}

.state-box .btn {
  margin-top: 8rpx;
}

.text-link {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 44px;
  color: var(--pine);
  font-size: 26rpx;
}

.demo-label {
  position: absolute;
  right: 12rpx;
  bottom: 12rpx;
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
  background: rgba(24,35,31,.72);
  color: #fff;
  font-size: 22rpx;
}

@media (prefers-reduced-motion: reduce) {
  .btn, .tap-active {
    transition: none !important;
    animation: none !important;
  }
}
