# Docker Compose production example
# Copy this file to .env before running docker compose.

PAYLOAD_SECRET=change-this-to-a-strong-random-value-in-production
MINIPROGRAM_TOKEN_SECRET=use-a-different-strong-random-value
PAYLOAD_PUBLIC_SERVER_URL=https://your-domain.example
# Postgres container credentials used by docker-compose.yml.
POSTGRES_USER=payload
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_DB=payload

# WeChat mini-program auth.
WECHAT_AUTH_MODE=wechat
WECHAT_APPID=wx22fb8f72be05d5c3
WECHAT_APP_SECRET=change-this-to-the-real-wechat-app-secret
# release / trial / develop; controls generated mini-program codes.
WECHAT_CODE_ENV_VERSION=release

# Schema changes must be applied deliberately by the migrate service.
PAYLOAD_DB_PUSH=false
