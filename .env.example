# 云端 Compose 与本机运维配置；本地 Next 开发使用 backend/.env。
# UTF-8 编码；每项独占一行。密钥不要提交到 Git，也不要粘贴到聊天或日志。
# 修改本机此文件不会自动更新服务器配置或 GitHub Secrets。

# ── 运行镜像（云端 Compose） ──
# 应用镜像，使用已发布提交的完整 SHA 标签；部署脚本自动更新。
APP_IMAGE=ccr.ccs.tencentyun.com/your-namespace/wechat_app:commit-sha
# 维护与同步工具镜像，标签应与 APP_IMAGE 一致。
TOOLS_IMAGE=ccr.ccs.tencentyun.com/your-namespace/wechat_app-tools:commit-sha

# ── PostgreSQL（云端私有网络） ──
# 数据库用户；已有数据卷不会因修改此值自动迁移账号。
POSTGRES_USER=zhaoshang
# 数据库密码；修改已有库密码需要单独执行数据库操作。
POSTGRES_PASSWORD=replace-with-strong-random-password
# 数据库名称。
POSTGRES_DB=zhaoshang_cloud_test
# 连接串须与上面三项一致；密码中的特殊字符需 URL 编码，云端主机名为 db。
DATABASE_URI=postgres://zhaoshang:replace-with-strong-random-password@db:5432/zhaoshang_cloud_test

# ── 应用密钥与访问地址 ──
# Payload 会话密钥，使用至少 32 字符的随机值。
PAYLOAD_SECRET=replace-with-strong-random-secret
# 小程序令牌密钥，必须与 PAYLOAD_SECRET 不同。
MINIPROGRAM_TOKEN_SECRET=replace-with-a-different-strong-random-secret
# 后台与素材公开地址，云端必须使用真实 HTTPS 域名，不带 /admin 或 /api。
PAYLOAD_PUBLIC_SERVER_URL=https://api.example.com
# 正常运行保持 false；云端 Compose 固定关闭，结构变更使用 schema:push。
PAYLOAD_DB_PUSH=false

# ── 微信小程序 ──
# 云端 Compose 固定为 wechat；dev 只用于本地模拟登录。
WECHAT_AUTH_MODE=wechat
# 须与 mp/project.config.json 的 AppID 一致。
WECHAT_APPID=wx98ad42097b40a52d
# 对应小程序的 AppSecret，仅保存在服务端。
WECHAT_APP_SECRET=
# 生成小程序码的目标版本：develop / trial / release。
WECHAT_CODE_ENV_VERSION=trial

# ── 腾讯文档连接 ──
# 官方 MCP 接入地址。云端通过 CMS 连接设置保存，根 .env 不自动注入此项。
TENCENT_DOCS_MCP_URL=https://docs.qq.com/openapi/mcp
# 仅本机维护备用；云端在 CMS 保存到同步卷。backend/.env 中此值优先于后台配置。
TENCENT_DOCS_MCP_TOKEN=

# ── 腾讯镜像仓库（本机配置 GitHub 时使用） ──
# 仅仓库主机名，不含 https:// 或命名空间。
REGISTRY_HOST=ccr.ccs.tencentyun.com
# 命名空间备忘；CI 实际使用下面的完整 REGISTRY_IMAGE。
REGISTRY_NAMESPACE=your-namespace
# 完整应用仓库路径，不带标签；工具仓库自动追加 -tools。
REGISTRY_IMAGE=ccr.ccs.tencentyun.com/your-namespace/wechat_app
# 仓库登录用户名，对应 GitHub Repository Secret。
REGISTRY_USER=
# 仓库专用密码，对应 GitHub Repository Secret，不是云服务器密码。
REGISTRY_PASSWORD=

# ── SSH 维护（仅本机，不注入应用容器） ──
# 云服务器 SSH 地址。
SSH_IP=
# SSH 端口。
SSH_PORT=22
# SSH 登录用户。
SSH_USER=ubuntu
# 本机专用私钥路径；CI 使用 GitHub Environment Secret。
SSH_PRIVATE_KEY_FILE=deploy/local/github-actions.key
# 可选：本机密码登录备用；CI 使用密钥，不使用此密码。
SSH_PASSWORD=
# 服务器现有部署目录，须与 GitHub Environment Variable 保持一致。
DEPLOY_PATH=/opt/zhaoshang-test

# ── CMS 人工维护与冒烟检查（仅本机） ──
# 现有管理员邮箱；填写不会自动创建用户。
CMS_ADMIN_EMAIL=
# 现有管理员密码；仅维护工具使用，不写入镜像或 GitHub。
CMS_ADMIN_PASSWORD=
