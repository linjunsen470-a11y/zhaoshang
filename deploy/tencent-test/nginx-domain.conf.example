# Enable only after DNS/access requirements and a certificate for api.cqwushi.com
# are ready. Existing HAProxy must route this exact SNI to wushi_https as well.
server {
    listen 80;
    listen [::]:80;
    server_name api.cqwushi.com;
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        try_files $uri =404;
    }
    location / { return 301 https://api.cqwushi.com$request_uri; }
}

server {
    listen 127.0.0.1:8443 ssl http2 proxy_protocol;
    set_real_ip_from 127.0.0.1;
    real_ip_header proxy_protocol;
    server_name api.cqwushi.com;
    ssl_certificate /etc/letsencrypt/live/api.cqwushi.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.cqwushi.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 11m;
    location / {
        proxy_pass http://127.0.0.1:3300;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 90s;
        proxy_send_timeout 90s;
    }
}
